{
  "name": "msec-technology-consulting",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:knowledge": "node scripts/build-knowledge.mjs",
    "check:knowledge": "node scripts/build-knowledge.mjs --check",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:credentials": "node scripts/check-credentials.mjs",
    "test:unit": "node --experimental-strip-types --test",
    "lint": "npm run check && npm run validate:html && npm run check:links",
    "test": "npm run test:unit && npm run build && npm run lint && npm run check:credentials",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@playwright/test": "^1.64.1",
    "html-validate": "^11.17.0",
    "typescript": "^6.0.3"
  }
}
