---
import { render } from 'astro:content';
import ShareLinks from './ShareLinks.astro';
import { absoluteUrl, localePath, SITE, type Locale } from '../config/site';
import { getDict } from '../i18n/utils';
import { formatPostDate, postPath, postSlug, readingMinutes, type BlogEntry } from '../lib/blog';

interface Props {
  locale: Locale;
  entry: BlogEntry;
}

const { locale, entry } = Astro.props;
const dict = getDict(locale);
const slug = postSlug(entry);
const url = absoluteUrl(postPath(locale, slug));
const { Content } = await render(entry);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  inLanguage: locale,
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: entry.data.author },
  publisher: { '@type': 'Organization', name: SITE.name, url: absoluteUrl('/') },
};
---

<article class="article">
  <div class="container container--narrow">
    <a class="back-link" href={localePath(locale, 'blog/')}>
      <span aria-hidden="true">←</span>{dict.blog.backToBlog}
    </a>

    <header class="article__header">
      <h1>{entry.data.title}</h1>
      <p class="article__description">{entry.data.description}</p>
      <div class="article__meta">
        <span>{dict.blog.by} {entry.data.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={entry.data.date.toISOString()}>{formatPostDate(entry.data.date, locale)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(entry)} {dict.blog.minRead}</span>
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {entry.data.tags.length > 0 && (
      <ul class="article__tags" aria-label="Tags">
        {entry.data.tags.map((tag: string) => <li>{tag}</li>)}
      </ul>
    )}

    <ShareLinks locale={locale} url={url} title={entry.data.title} />
  </div>
</article>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .article {
    padding-block: clamp(2rem, 6vw, 4.5rem) clamp(4rem, 9vw, 7rem);
  }

  .back-link {
    display: inline-flex;
    min-height: var(--ms-touch);
    align-items: center;
    gap: 0.45rem;
    color: var(--ms-text-secondary);
    font-size: var(--ms-text-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--ms-accent);
  }

  .article__header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--ms-border);
  }

  .article__header h1 {
    margin-top: 0.8rem;
    font-size: var(--ms-display-sm);
    font-weight: 850;
    line-height: 1.08;
  }

  .article__description {
    margin-top: 0.85rem;
    color: var(--ms-text-secondary);
    font-size: var(--ms-text-lg);
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
    color: var(--ms-text-muted);
    font-size: var(--ms-text-xs);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  .article__tags li {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--ms-border);
    border-radius: var(--ms-radius-pill);
    color: var(--ms-text-secondary);
    font-size: var(--ms-text-xs);
  }
</style>
