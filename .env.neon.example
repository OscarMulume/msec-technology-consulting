# ============================================================
# M-Sec Technology Consulting - Template base de donnees distant
# ------------------------------------------------------------
# Copier vers .env.local et completer LES VALEURS.
# Deux prestataires supportes : Supabase OU Neon (serverless Postgres).
#
# Site statique Astro : les variables CI/CD de deploiement (Stripe,
# SideShift, Supabase service_role) vivent dans les secrets de la
# plateforme de deploiement, jamais dans le bundle.
# ============================================================

# --- Fournisseur actif : supabase | neon ---
DB_PROVIDER=supabase

# ====================================================================
# OPTION A - SUPABASE (auth + storage + DB)
# ====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle_anon_publique_de_votre_projet
SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.<ref>
SUPABASE_DB_PASSWORD=<mot_de_passe_du_role>
SUPABASE_SERVICE_ROLE_KEY=cle_service_role_secrete

# ====================================================================
# OPTION B - NEON
# ====================================================================
NEON_DATABASE_URL=postgresql://<user>:<password>@ep-<project>-pooler.<region>.aws.neon.tech/msec?sslmode=require
NEON_HOST=ep-<project>-pooler.<region>.aws.neon.tech
NEON_PORT=5432
NEON_DATABASE=msec
NEON_USERNAME=<user>
NEON_PASSWORD=<password>