---
import { whatsappLink } from '../config/site';
import { getDict } from '../i18n/utils';
import type { Locale } from '../config/site';

interface Props {
  locale: Locale;
  message: string;
}

const { locale, message } = Astro.props;
const dict = getDict(locale);
const href = whatsappLink(message);
---

{href && (
  <a class="whatsapp-float glass" href={href} target="_blank" rel="noopener noreferrer" aria-label={`${dict.common.whatsapp} (${dict.common.opensNewTab})`}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.4-4.5a8.4 8.4 0 1 1 15.6-4.3Z"></path>
      <path d="M8.4 7.9c.2-.4.4-.4.7-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.3 0 .5-.1.7l-.5.7c-.2.2-.2.4 0 .7.4.7 1 1.3 1.7 1.8.4.3.9.5 1.3.7.3.1.5.1.7-.1l.7-.8c.2-.2.4-.2.6-.1l2 1c.3.1.5.3.5.5 0 .3-.1 1.2-.6 1.7-.5.6-1.3.9-2.2.7-1.3-.3-3.2-1-4.9-2.5-1.3-1.2-2.2-2.6-2.5-3.6-.3-.9-.1-1.7.4-2.3Z"></path>
    </svg>
    <span class="visually-hidden">{dict.common.whatsapp}</span>
  </a>
)}

<style>
  .whatsapp-float {
    position: fixed;
    z-index: 900;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: inline-flex;
    width: 3.25rem;
    height: 3.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--ms-success);
    text-decoration: none;
    transition: transform 0.2s var(--ms-ease);
  }

  .whatsapp-float:hover {
    transform: translateY(-2px) scale(1.03);
  }

  .whatsapp-float svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 640px) {
    .whatsapp-float {
      width: 3rem;
      height: 3rem;
    }
  }
</style>
