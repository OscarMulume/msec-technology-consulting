# Sécurité — secrets jamais versionnés (voir .github/workflows/secrets-scan.yml)
.env
.env.*
!.env.example
!.env.neon.example
secrets/
tokens/
sessions/
*.key
*.pem
*.p12

# Sources images lourdes (copies locales, non versionnées)
assets/images/source/*.png

# Node / Astro
node_modules/
dist/
.astro/
npm-debug.log*

# Éditeurs / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.tmp
