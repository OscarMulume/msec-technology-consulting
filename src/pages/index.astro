---
// Page d'accueil M-Sec Technology Consulting
// Design System Premium iOS / Apple — glassmorphism, bento grid asymétrique, animations fluides
// Données des services chargées côté client via Supabase
---
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="M-Sec Technology Consulting — Cabinet d'ingénierie IT, réseaux et cybersécurité en Afrique centrale. Infrastructure résiliente, connectivité critique, sécurité par conception. SLA 99,9%, réponse 2h, monitoring 24/7." />
  <meta name="keywords" content="M-Sec, Technology Consulting, cybersécurité, réseau, infrastructure IT, Kinshasa, RDC, Afrique centrale, FortiGate, Cisco, UniFi, audit gratuit" />
  <meta name="theme-color" content="#05060a" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="M-Sec Technology Consulting | Infrastructure IT • Cybersécurité • Connectivité" />
  <meta property="og:description" content="L'infrastructure et la sécurité IT au service de la performance de votre entreprise. Cabinet expert Afrique centrale. SLA 99,9%." />
  <meta property="og:url" content="https://oscarmulume.github.io/msec-technology-consulting/" />
  <title>M-Sec Technology Consulting | Infrastructure IT • Cybersécurité • Connectivité</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    /* ═══════ Design System M-SEC — Premium iOS ═══════ */
    :root {
      --bg: #05060a;
      --bg-2: #0a0c12;
      --bg-3: #0f121a;
      --cyan: #22d3ee;
      --cyan-dim: #0891b2;
      --cyan-g: rgba(34, 211, 238, 0.10);
      --green: #10b981;
      --green-g: rgba(16, 185, 129, 0.10);
      --teal: #14b8a6;
      --glass: rgba(255, 255, 255, 0.03);
      --glass-2: rgba(255, 255, 255, 0.05);
      --border: rgba(148, 163, 184, 0.10);
      --border-h: rgba(34, 211, 238, 0.25);
      --text: #f1f5f9;
      --text-2: #94a3b8;
      --text-3: #64748b;
      --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      --smooth: cubic-bezier(0.22, 1, 0.36, 1);
      --expo: cubic-bezier(0.16, 1, 0.3, 1);
      --radius: 22px;
      --radius-sm: 14px;
      --radius-xs: 10px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg); color: var(--text);
      line-height: 1.65; -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale; overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }
    ul, ol { list-style: none; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    img { max-width: 100%; }

    /* ── Fond & effets ── */
    #bgCanvas { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    .orb { position: fixed; border-radius: 50%; filter: blur(150px); pointer-events: none; z-index: 0; }
    .orb-1 { width: 640px; height: 640px; top: -240px; right: -220px; background: radial-gradient(circle, rgba(34,211,238,0.09) 0%, transparent 70%); animation: float1 28s ease-in-out infinite; }
    .orb-2 { width: 560px; height: 560px; bottom: 8%; left: -240px; background: radial-gradient(circle, rgba(16,185,129,0.07) 0%, transparent 70%); animation: float2 34s ease-in-out infinite; }
    .orb-3 { width: 420px; height: 420px; top: 46%; left: 52%; background: radial-gradient(circle, rgba(20,184,166,0.05) 0%, transparent 70%); animation: float3 24s ease-in-out infinite; }
    @keyframes float1 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-60px,40px)} }
    @keyframes float2 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(50px,-50px)} }
    @keyframes float3 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-40px,40px)} }
    body::after {
      content: ''; position: fixed; inset: 0; z-index: 1; pointer-events: none; opacity: 0.03;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-repeat: repeat; background-size: 256px;
    }

    /* ── Navigation ── */
    .nav { position: fixed; top: 14px; left: 50%; transform: translateX(-50%); z-index: 1000; width: calc(100% - 32px); max-width: 960px; }
    .nav-pill {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 12px 10px 22px; border-radius: 100px;
      background: rgba(10, 12, 18, 0.55);
      backdrop-filter: blur(40px) saturate(1.8); -webkit-backdrop-filter: blur(40px) saturate(1.8);
      border: 1px solid var(--border); transition: all 0.6s var(--expo);
    }
    .nav.scrolled .nav-pill { background: rgba(10, 12, 18, 0.85); border-color: rgba(34,211,238,0.18); box-shadow: 0 10px 40px rgba(0,0,0,0.4); }
    .logo { display: flex; align-items: center; gap: 8px; font-size: 1.05rem; font-weight: 800; letter-spacing: -0.02em; }
    .logo-mark {
      width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, rgba(34,211,238,0.9), rgba(16,185,129,0.9));
      color: #04141a; font-weight: 900; font-size: 0.95rem; box-shadow: 0 0 18px rgba(34,211,238,0.35);
    }
    .logo em { font-style: normal; color: var(--cyan); }
    .logo span { color: var(--text-2); font-weight: 500; font-size: 0.8rem; }
    .nav-links { display: flex; gap: 2px; align-items: center; }
    .nav-links a { color: var(--text-2); font-size: 0.8125rem; font-weight: 500; padding: 8px 14px; border-radius: 100px; transition: all 0.35s var(--smooth); }
    .nav-links a:hover { color: var(--text); background: rgba(255,255,255,0.05); }
    .nav-cta { display: inline-flex; align-items: center; padding: 8px 20px; border-radius: 100px; font-size: 0.8125rem !important; font-weight: 600 !important; background: linear-gradient(135deg, var(--cyan-dim), var(--cyan)); color: #03130f !important; box-shadow: 0 2px 14px rgba(34,211,238,0.3); transition: all 0.4s var(--spring); }
    .nav-cta:hover { transform: scale(1.04); box-shadow: 0 4px 22px rgba(34,211,238,0.45); color: #03130f !important; background: linear-gradient(135deg, var(--cyan-dim), var(--cyan)); }
    .mob-btn { display: none; width: 40px; height: 40px; border-radius: 12px; border: none; background: rgba(255,255,255,0.06); color: var(--text); cursor: pointer; align-items: center; justify-content: center; }
    .mob-menu { display: none; position: fixed; top: 74px; left: 16px; right: 16px; padding: 12px; border-radius: 20px; background: rgba(10,12,18,0.92); backdrop-filter: blur(40px); border: 1px solid var(--border); flex-direction: column; gap: 4px; z-index: 999; transform: translateY(-10px); opacity: 0; pointer-events: none; transition: all 0.4s var(--expo); }
    .mob-menu.open { transform: translateY(0); opacity: 1; pointer-events: all; }
    .mob-menu a { padding: 14px 16px; border-radius: 12px; font-size: 0.9375rem; font-weight: 500; color: var(--text-2); }
    .mob-menu a:hover { color: var(--text); background: rgba(255,255,255,0.05); }

    /* ── Boutons ── */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 26px; border-radius: 100px; font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: all 0.45s var(--spring); border: none; }
    .btn-primary { background: linear-gradient(135deg, var(--cyan-dim), var(--cyan)); color: #03130f; box-shadow: 0 4px 20px rgba(34,211,238,0.25); position: relative; overflow: hidden; }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(34,211,238,0.4); }
    .btn-ghost { background: rgba(255,255,255,0.04); color: var(--text); border: 1px solid var(--border); }
    .btn-ghost:hover { background: rgba(255,255,255,0.08); border-color: var(--border-h); transform: translateY(-2px); }
    .btn-white { background: linear-gradient(135deg, var(--green), var(--teal)); color: #03130f; box-shadow: 0 4px 20px rgba(16,185,129,0.25); }
    .btn-white:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(16,185,129,0.4); }
    .btn-group { display: flex; gap: 12px; flex-wrap: wrap; }

    /* ── Typo de section ── */
    .section { position: relative; z-index: 2; padding: 110px 24px; }
    .section-inner { max-width: 1200px; margin: 0 auto; }
    .section-center { text-align: center; }
    .section-label { display: inline-flex; align-items: center; gap: 8px; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cyan); margin-bottom: 18px; padding: 7px 16px; border-radius: 100px; background: var(--cyan-g); border: 1px solid rgba(34,211,238,0.18); }
    .section-title { font-size: clamp(2rem, 4.5vw, 3.5rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.08; margin-bottom: 18px; }
    .section-desc { font-size: 1.05rem; color: var(--text-2); max-width: 600px; margin: 0 auto 0; line-height: 1.75; }
    .section-center .section-desc { margin-left: auto; margin-right: auto; }
    .section-head { margin-bottom: 64px; }
    .section-center .section-head { text-align: center; }

    /* ── HERO ── */
    .hero { position: relative; z-index: 2; min-height: 100vh; display: flex; align-items: center; padding: 130px 24px 70px; }
    .hero-inner { max-width: 1200px; margin: 0 auto; width: 100%; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 60px; align-items: center; }
    .hero-content { position: relative; }
    .hero-badge { display: inline-flex; align-items: center; gap: 9px; padding: 9px 20px; border-radius: 100px; background: var(--glass); backdrop-filter: blur(20px); border: 1px solid var(--border); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); margin-bottom: 32px; }
    .hero-badge-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px rgba(16,185,129,0.8); animation: pulse 2s ease-in-out infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.55;transform:scale(0.8)} }
    .hero h1 { font-size: clamp(2.6rem, 6.4vw, 4.8rem); font-weight: 900; letter-spacing: -0.045em; line-height: 1.02; margin-bottom: 22px; }
    .hero h1 .accent { background: linear-gradient(135deg, var(--cyan) 0%, var(--teal) 60%, var(--green)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .hero-tagline { font-size: 1.1rem; color: var(--text-2); max-width: 520px; margin-bottom: 20px; line-height: 1.65; font-weight: 400; }
    .hero-manifesto { font-size: 0.9rem; color: var(--text-3); max-width: 520px; margin-bottom: 34px; line-height: 1.8; font-style: italic; border-left: 2px solid rgba(34,211,238,0.4); padding-left: 16px; }
    .hero .btn-group { margin-bottom: 44px; }

    /* Widgets stats flottants */
    .hero-visual { position: relative; }
    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .stat-card { padding: 26px 22px; border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(30px) saturate(1.5); -webkit-backdrop-filter: blur(30px) saturate(1.5); border: 1px solid var(--border); text-align: center; transition: all 0.5s var(--spring); position: relative; overflow: hidden; }
    .stat-card::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(34,211,238,0.05) 0%, transparent 60%); pointer-events: none; }
    .stat-card:hover { transform: translateY(-4px); border-color: var(--border-h); box-shadow: 0 14px 40px rgba(0,0,0,0.3); }
    .stat-n { font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; background: linear-gradient(135deg, var(--text), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; line-height: 1.1; }
    .stat-l { font-size: 0.72rem; color: var(--text-3); font-weight: 500; margin-top: 6px; text-transform: uppercase; letter-spacing: 0.08em; }
    .hero-note { margin-top: 20px; display: flex; align-items: center; gap: 10px; font-size: 0.8rem; color: var(--text-3); }
    .hero-note svg { color: var(--green); flex-shrink: 0; }

    /* ── Animation reveal ── */
    .reveal { opacity: 0; transform: translateY(34px); transition: all 0.85s var(--expo); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-1 { transition-delay: 0.1s; } .reveal-2 { transition-delay: 0.2s; }
    .reveal-3 { transition-delay: 0.3s; } .reveal-4 { transition-delay: 0.4s; }
    .reveal-5 { transition-delay: 0.5s; }

    /* ── Pourquoi M-Sec ── */
    .value-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .value-card { padding: 30px; border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(26px); border: 1px solid var(--border); transition: all 0.5s var(--spring); position: relative; overflow: hidden; }
    .value-card::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, transparent 55%); pointer-events: none; }
    .value-card:hover { transform: translateY(-5px); border-color: var(--border-h); box-shadow: 0 16px 44px rgba(0,0,0,0.3); }
    .value-icon { width: 46px; height: 46px; border-radius: 14px; background: var(--cyan-g); border: 1px solid rgba(34,211,238,0.16); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-bottom: 18px; color: var(--cyan); }
    .value-card:nth-child(2n) .value-icon { background: var(--green-g); border-color: rgba(16,185,129,0.16); color: var(--green); }
    .value-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 10px; letter-spacing: -0.01em; }
    .value-card p { font-size: 0.875rem; color: var(--text-2); line-height: 1.7; }

    /* ── Intro de marque ── */
    .brand-box { padding: 44px 48px; border-radius: 26px; background: linear-gradient(135deg, rgba(34,211,238,0.05), rgba(16,185,129,0.04)); backdrop-filter: blur(30px); border: 1px solid var(--border); position: relative; overflow: hidden; }
    .brand-box::before { content: ''; position: absolute; top: -120px; right: -120px; width: 320px; height: 320px; border-radius: 50%; background: radial-gradient(circle, rgba(34,211,238,0.12), transparent 70%); }
    .brand-box h3 { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 20px; position: relative; }
    .brand-box p { font-size: 1rem; color: var(--text-2); line-height: 1.85; max-width: 820px; position: relative; }
    .brand-box strong { color: var(--text); font-weight: 700; }

    /* ── Galerie ── */
    .gallery-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; }
    .gallery-card { position: relative; border-radius: 18px; overflow: hidden; cursor: pointer; border: 1px solid var(--border); background: var(--bg-2); transition: all 0.45s var(--smooth); }
    .gallery-card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s var(--smooth); }
    .gallery-card:hover { transform: translateY(-4px); border-color: var(--border-h); box-shadow: 0 16px 40px rgba(0,0,0,0.35); }
    .gallery-card:hover img { transform: scale(1.04); }
    .gallery-card.featured { grid-column: span 4; grid-row: span 2; }
    .gallery-card.tall { grid-column: span 2; grid-row: span 2; }
    .gallery-card.norm { grid-column: span 2; }
    .gallery-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 28px 20px 16px; background: linear-gradient(transparent, rgba(5,6,10,0.92)); }
    .gallery-overlay h4 { font-size: 0.95rem; font-weight: 700; }
    .gallery-overlay p { font-size: 0.75rem; color: var(--text-2); margin-top: 2px; }

    /* ── Services bento ── */
    .bento { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: minmax(170px, auto); gap: 16px; }
    .bento-card { padding: 30px; border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(24px) saturate(1.4); border: 1px solid var(--border); transition: all 0.5s var(--spring); position: relative; overflow: hidden; display: flex; flex-direction: column; }
    .bento-card::after { content: ''; position: absolute; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle, var(--cyan-g), transparent 70%); pointer-events: none; opacity: 0; transition: opacity 0.5s; transform: translate(var(--mx,50%), var(--my,50%)) translate(-50%,-50%); }
    .bento-card:hover { border-color: var(--border-h); transform: translateY(-4px); box-shadow: 0 16px 46px rgba(0,0,0,0.3); }
    .bento-card:hover::after { opacity: 1; }
    .bento-card:nth-child(1) { grid-column: span 7; }
    .bento-card:nth-child(2) { grid-column: span 5; }
    .bento-card:nth-child(3) { grid-column: span 5; }
    .bento-card:nth-child(4) { grid-column: span 7; }
    .bento-card:nth-child(5) { grid-column: span 12; grid-row: span 1; }
    .bento-card:last-child { background: linear-gradient(135deg, rgba(34,211,238,0.14), rgba(16,185,129,0.10)); border: 1px solid rgba(34,211,238,0.3); }
    .bento-icon { width: 50px; height: 50px; border-radius: 15px; background: var(--cyan-g); border: 1px solid rgba(34,211,238,0.16); display: flex; align-items: center; justify-content: center; font-size: 1.45rem; margin-bottom: 18px; color: var(--cyan); flex-shrink: 0; transition: all 0.4s var(--spring); }
    .bento-card:hover .bento-icon { transform: scale(1.08); box-shadow: 0 6px 20px rgba(34,211,238,0.25); }
    .bento-card:nth-child(3n) .bento-icon { background: var(--green-g); border-color: rgba(16,185,129,0.16); color: var(--green); }
    .bento-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 10px; letter-spacing: -0.01em; }
    .bento-card p { font-size: 0.875rem; color: var(--text-2); line-height: 1.7; flex: 1; }
    .bento-card .bento-benefit { margin-top: 4px; color: var(--text-3); }
    .bento-card .bento-benefit strong { color: var(--green); }
    .bento-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 18px; font-size: 0.8125rem; color: var(--cyan); font-weight: 600; transition: gap 0.3s var(--smooth); }
    .bento-link:hover { gap: 12px; }
    .bento-card:last-child .bento-icon { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.16); color: #fff; }

    /* ── Engagements SLA ── */
    .eng-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; }
    .eng-card { padding: 30px; border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(24px); border: 1px solid var(--border); transition: all 0.5s var(--spring); position: relative; }
    .eng-card:hover { border-color: var(--border-h); transform: translateY(-4px); }
    .eng-card:nth-child(1) { grid-column: span 5; }
    .eng-card:nth-child(2) { grid-column: span 7; }
    .eng-card:nth-child(3) { grid-column: span 7; }
    .eng-card:nth-child(4) { grid-column: span 5; }
    .eng-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; margin-bottom: 18px; }
    .eng-card:nth-child(odd) .eng-icon { background: var(--cyan-g); color: var(--cyan); }
    .eng-card:nth-child(even) .eng-icon { background: var(--green-g); color: var(--green); }
    .eng-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 10px; }
    .eng-card p { font-size: 0.875rem; color: var(--text-2); line-height: 1.7; }
    .eng-big { font-family: 'JetBrains Mono', monospace; font-size: 2.6rem; font-weight: 700; letter-spacing: -0.04em; background: linear-gradient(135deg, var(--cyan), var(--green)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; line-height: 1.1; margin-bottom: 8px; }

    /* ── Méthodologie ── */
    .method-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; position: relative; }
    .method-step { padding: 30px 24px; border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(24px); border: 1px solid var(--border); text-align: center; transition: all 0.5s var(--spring); position: relative; }
    .method-step:hover { border-color: var(--border-h); transform: translateY(-4px); }
    .method-num { width: 46px; height: 46px; margin: 0 auto 18px; border-radius: 15px; background: linear-gradient(135deg, var(--cyan-dim), var(--cyan)); color: #03130f; font-family: 'JetBrains Mono', monospace; font-size: 0.95rem; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 20px rgba(34,211,238,0.3); transition: all 0.4s var(--spring); }
    .method-step:hover .method-num { transform: scale(1.1) translateY(-4px); }
    .method-step:nth-child(even) .method-num { background: linear-gradient(135deg, var(--green), var(--teal)); box-shadow: 0 6px 20px rgba(16,185,129,0.3); }
    .method-step h3 { font-size: 1rem; font-weight: 700; margin-bottom: 10px; }
    .method-step p { font-size: 0.8125rem; color: var(--text-2); line-height: 1.65; }

    /* ── Valeurs / Charte ── */
    .values-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
    .value-pill { padding: 28px; border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(22px); border: 1px solid var(--border); text-align: center; transition: all 0.5s var(--spring); }
    .value-pill:hover { border-color: var(--border-h); transform: translateY(-4px); }
    .value-pill-icon { font-size: 1.8rem; margin-bottom: 14px; }
    .value-pill h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
    .value-pill p { font-size: 0.8125rem; color: var(--text-2); line-height: 1.65; }

    /* ── Conformité & Confidentialité ── */
    .compliance-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .comp-card { padding: 28px; border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(24px); border: 1px solid var(--border); transition: all 0.5s var(--spring); }
    .comp-card:hover { border-color: var(--border-h); transform: translateY(-4px); }
    .comp-icon { width: 44px; height: 44px; border-radius: 13px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; background: var(--cyan-g); color: var(--cyan); margin-bottom: 16px; }
    .comp-card:nth-child(2n) .comp-icon { background: var(--green-g); color: var(--green); }
    .comp-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 10px; }
    .comp-card p { font-size: 0.85rem; color: var(--text-2); line-height: 1.7; }
    .comp-card ul { margin-top: 12px; }
    .comp-card li { font-size: 0.8125rem; color: var(--text-2); padding: 5px 0 5px 22px; position: relative; line-height: 1.6; }
    .comp-card li::before { content: '✓'; position: absolute; left: 0; color: var(--green); font-weight: 700; }

    /* ── Études de cas ── */
    .cases-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .case-card { padding: 34px; border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(24px); border: 1px solid var(--border); transition: all 0.5s var(--spring); position: relative; overflow: hidden; }
    .case-card:hover { border-color: var(--border-h); transform: translateY(-4px); }
    .case-tag { display: inline-flex; align-items: center; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cyan); background: var(--cyan-g); border: 1px solid rgba(34,211,238,0.18); padding: 6px 14px; border-radius: 100px; margin-bottom: 18px; }
    .case-card h3 { font-size: 1.3rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 22px; }
    .case-segment { border-left: 2px solid rgba(34,211,238,0.3); padding: 6px 0 6px 18px; margin-bottom: 18px; }
    .case-seg-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--green); margin-bottom: 6px; }
    .case-segment p { font-size: 0.875rem; color: var(--text-2); line-height: 1.75; }

    /* ── Certifications ── */
    .cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .cert-card { padding: 28px; border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(24px); border: 1px solid var(--border); display: flex; gap: 18px; transition: all 0.5s var(--spring); position: relative; }
    .cert-card:hover { border-color: var(--border-h); transform: translateY(-4px); }
    .cert-icon { width: 52px; height: 52px; border-radius: 15px; background: var(--cyan-g); color: var(--cyan); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0; border: 1px solid rgba(34,211,238,0.16); }
    .cert-card:nth-child(even) .cert-icon { background: var(--green-g); color: var(--green); border-color: rgba(16,185,129,0.16); }
    .cert-domain { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-3); margin-bottom: 8px; }
    .cert-body h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.01em; }
    .cert-body p { font-size: 0.855rem; color: var(--text-2); line-height: 1.7; }
    .cert-note { margin-top: 28px; padding: 20px 24px; border-radius: var(--radius-sm); background: linear-gradient(135deg, rgba(34,211,238,0.06), rgba(16,185,129,0.05)); border: 1px solid var(--border); display: flex; gap: 14px; align-items: flex-start; }
    .cert-note-icon { width: 26px; height: 26px; border-radius: 50%; background: var(--green); color: #03130f; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem; flex-shrink: 0; box-shadow: 0 0 16px rgba(16,185,129,0.5); }
    .cert-note p { font-size: 0.875rem; color: var(--text-2); line-height: 1.7; }

    /* ── Formulaires ── */
    .form-wrap { background: var(--glass); padding: 32px; border-radius: var(--radius); border: 1px solid var(--border); backdrop-filter: blur(28px); }
    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 0.78rem; font-weight: 600; margin-bottom: 8px; color: var(--text); letter-spacing: 0.02em; }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%; padding: 14px 17px; border-radius: var(--radius-sm);
      background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      color: var(--text); font-size: 0.925rem; font-family: inherit; outline: none;
      transition: all 0.35s var(--smooth);
    }
    .form-group input::placeholder, .form-group textarea::placeholder { color: var(--text-3); }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--cyan); background: rgba(34,211,238,0.04); box-shadow: 0 0 0 3px rgba(34,211,238,0.08); }
    .form-group select { appearance: none; cursor: pointer; background-image: url("data:image/svg+xml,%3Csvg width='12' height='12' fill='none' stroke='%2394a3b8' stroke-width='2' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 16px center; }
    .form-group select option { background: var(--bg-2); color: var(--text); }
    .form-group textarea { min-height: 110px; resize: vertical; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-submit { width: 100%; justify-content: center; }
    .form-success { display: none; padding: 14px; border-radius: var(--radius-sm); background: var(--green-g); border: 1px solid rgba(16,185,129,0.25); color: var(--green); font-size: 0.875rem; text-align: center; margin-top: 16px; }
    .form-error { display: none; padding: 14px; border-radius: var(--radius-sm); background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25); color: #f87171; font-size: 0.875rem; text-align: center; margin-top: 16px; }

    /* ── Audit ── */
    .audit-inner { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: start; }
    .audit-benefits { display: flex; flex-direction: column; gap: 14px; }
    .audit-benefit { display: flex; align-items: flex-start; gap: 16px; padding: 22px; border-radius: var(--radius-sm); background: var(--glass); border: 1px solid var(--border); transition: all 0.4s var(--smooth); }
    .audit-benefit:hover { border-color: var(--border-h); transform: translateX(4px); }
    .audit-icon { width: 44px; height: 44px; border-radius: 13px; background: var(--cyan-g); color: var(--cyan); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
    .audit-benefit:nth-child(even) .audit-icon { background: var(--green-g); color: var(--green); }
    .audit-benefit h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 4px; }
    .audit-benefit p { font-size: 0.82rem; color: var(--text-2); line-height: 1.6; }

    /* ── Contact ── */
    .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 48px; }
    .contact-card { padding: 26px; border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(24px); border: 1px solid var(--border); text-align: center; transition: all 0.4s var(--smooth); }
    .contact-card:hover { border-color: var(--border-h); transform: translateY(-4px); }
    .contact-icon { width: 46px; height: 46px; margin: 0 auto 14px; border-radius: 14px; background: var(--cyan-g); color: var(--cyan); display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
    .contact-card:nth-child(even) .contact-icon { background: var(--green-g); color: var(--green); }
    .contact-card h4 { font-size: 0.9rem; font-weight: 700; margin-bottom: 6px; }
    .contact-card p { font-size: 0.84rem; color: var(--text-2); }

    /* ── CTA final ── */
    .cta-panel { padding: 60px; border-radius: 30px; background: linear-gradient(135deg, rgba(34,211,238,0.10), rgba(16,185,129,0.08)); backdrop-filter: blur(30px); border: 1px solid rgba(34,211,238,0.2); text-align: center; position: relative; overflow: hidden; }
    .cta-panel::before { content: ''; position: absolute; top: -150px; right: -100px; width: 360px; height: 360px; border-radius: 50%; background: radial-gradient(circle, rgba(34,211,238,0.15), transparent 70%); }
    .cta-panel h2 { font-size: clamp(1.6rem, 3.5vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 14px; position: relative; }
    .cta-panel p { font-size: 1rem; color: var(--text-2); max-width: 560px; margin: 0 auto 28px; position: relative; }

    /* ── Footer ── */
    .footer { position: relative; z-index: 2; padding: 60px 24px 32px; border-top: 1px solid var(--border); }
    .footer-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 44px; }
    .footer-brand p { font-size: 0.85rem; color: var(--text-3); margin-top: 14px; line-height: 1.7; max-width: 300px; }
    .footer-col h4 { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text); margin-bottom: 16px; }
    .footer-col a { display: block; font-size: 0.85rem; color: var(--text-3); padding: 6px 0; transition: all 0.3s; }
    .footer-col a:hover { color: var(--text); transform: translateX(4px); }
    .footer-bottom { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding-top: 24px; border-top: 1px solid var(--border); font-size: 0.76rem; color: var(--text-3); }
    .footer-legal { display: flex; gap: 20px; flex-wrap: wrap; }
    .footer-legal a { color: var(--text-3); transition: color 0.3s; }
    .footer-legal a:hover { color: var(--cyan); }

    /* ── Lightbox ── */
    .lightbox { display: none; position: fixed; inset: 0; z-index: 2000; background: rgba(0,0,0,0.93); align-items: center; justify-content: center; cursor: zoom-out; padding: 24px; }
    .lightbox.open { display: flex; }
    .lightbox img { max-width: 92vw; max-height: 86vh; object-fit: contain; border-radius: 14px; }
    .lightbox-close { position: absolute; top: 22px; right: 28px; color: #fff; font-size: 2.2rem; cursor: pointer; opacity: 0.75; transition: opacity 0.2s; background: none; border: none; }
    .lightbox-close:hover { opacity: 1; }

    /* ── Responsive ── */
    @media (max-width: 1024px) {
      .hero-inner { grid-template-columns: 1fr; gap: 48px; }
      .hero-visual { order: -1; max-width: 640px; margin: 0 auto; width: 100%; }
      .bento-card:nth-child(n) { grid-column: span 6; }
      .eng-card:nth-child(n) { grid-column: span 6; }
      .compliance-grid { grid-template-columns: 1fr 1fr; }
      .audit-inner { grid-template-columns: 1fr; }
      .footer-inner { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 768px) {
      .hero { min-height: auto; padding: 120px 20px 56px; }
      .nav-links { display: none; }
      .mob-btn { display: flex; }
      .section { padding: 70px 20px; }
      .bento-card:nth-child(n), .eng-card:nth-child(n) { grid-column: span 12; }
      .bento-card:last-child { grid-column: span 12; }
      .method-grid { grid-template-columns: 1fr 1fr; }
      .compliance-grid { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
      .cases-grid, .cert-grid { grid-template-columns: 1fr; }
      .footer-inner { grid-template-columns: 1fr; gap: 28px; }
      .gallery-card.featured, .gallery-card.tall, .gallery-card.norm { grid-column: span 2; grid-row: span 1; }
      .cta-panel { padding: 40px 24px; }
    }
    @media (max-width: 480px) {
      .method-grid { grid-template-columns: 1fr; }
      .stats-grid { grid-template-columns: 1fr 1fr; }
      .brand-box { padding: 30px 24px; }
    }
  </style>
</head>
