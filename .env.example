# Variables publiques (exposées au navigateur — aucune valeur secrète ici).
# Les valeurs réelles se configurent dans les « variables » du dépôt GitHub
# (Settings → Secrets and variables → Actions → Variables) et dans un .env local non versionné.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_WHATSAPP_NUMBER=
# Mettre « true » seulement après le déploiement de la fonction `assistant` (voir docs/ASSISTANT.md).
PUBLIC_ASSISTANT_ENABLED=
