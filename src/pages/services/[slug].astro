</div></section>

<footer class="footer">&copy; <span id="yr"></span> M-Sec Technology Consulting. Tous droits réservés.</footer>

<script>
// Canvas background
(() => {
  const canvas = document.getElementById('bgCanvas'), ctx = canvas.getContext('2d');
  const CELL = 48, RADIUS = 160, DOT_COLORS = ['34,211,238','16,185,129','20,184,166'];
  let w, h, cols, rows, targetMX = -9999, targetMY = -9999, mx = -9999, my = -9999, particles = [], frameCount = 0;
  function resize() { w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight; cols = Math.ceil(w / CELL) + 2; rows = Math.ceil(h / CELL) + 2; }
  function spawnParticle(x, y) { if (particles.length > 120) return; particles.push({ x, y, vx: (Math.random() - 0.5) * 0.5, vy: (Math.random() - 0.5) * 0.5, life: 1, decay: 0.008 + Math.random() * 0.01, size: 1 + Math.random() * 1.5, color: DOT_COLORS[Math.floor(Math.random() * DOT_COLORS.length)] }); }
  function draw() {
    ctx.clearRect(0, 0, w, h); frameCount++;
    mx += (targetMX - mx) * 0.1; my += (targetMY - my) * 0.1;
    const speed = Math.sqrt((mx - targetMX) ** 2 + (my - targetMY) ** 2);
    if (speed > 2) { const c = Math.min(Math.floor(speed / 4), 2); for (let i = 0; i < c; i++) spawnParticle(mx + (Math.random() - 0.5) * 12, my + (Math.random() - 0.5) * 12); }
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
      const cx = c * CELL + CELL / 2, cy = r * CELL + CELL / 2;
      const dist = Math.sqrt((cx - mx) ** 2 + (cy - my) ** 2);
      if (dist < RADIUS) {
        const intensity = Math.pow(1 - dist / RADIUS, 2.5);
        ctx.fillStyle = `rgba(34,211,238,${intensity * 0.07})`; ctx.fillRect(cx - CELL / 2, cy - CELL / 2, CELL - 1, CELL - 1);
        ctx.beginPath(); ctx.arc(cx, cy, 1 + intensity * 1.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(34,211,238,${0.1 + intensity * 0.5})`; ctx.fill();
      } else { ctx.beginPath(); ctx.arc(cx, cy, 0.5, 0, Math.PI * 2); ctx.fillStyle = 'rgba(148,163,184,0.03)'; ctx.fill(); }
    }
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i]; p.x += p.vx; p.y += p.vy; p.life -= p.decay;
      if (p.life <= 0) { particles.splice(i, 1); continue; }
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${p.color},${p.life * 0.4})`; ctx.fill();
    }
    const grad = ctx.createRadialGradient(mx, my, 0, mx, my, RADIUS);
    grad.addColorStop(0, 'rgba(34,211,238,0.06)'); grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad; ctx.fillRect(mx - RADIUS, my - RADIUS, RADIUS * 2, RADIUS * 2);
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize', resize); window.addEventListener('mousemove', e => { targetMX = e.clientX; targetMY = e.clientY; });
  window.addEventListener('mouseleave', () => { targetMX = -9999; targetMY = -9999; });
  resize(); draw();
})();

// Nav
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 50));
const mb = document.getElementById('mobBtn'), mm = document.getElementById('mobMenu');
mb?.addEventListener('click', () => mm.classList.toggle('open'));
mm?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mm.classList.remove('open')));
document.getElementById('yr').textContent = new Date().getFullYear();

// Service data
const SERVICE_SLUG = window.location.pathname.split('/services/')[1]?.replace('/', '');

const servicesData = {
