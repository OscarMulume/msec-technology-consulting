---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SITE, absoluteMedia, absoluteUrl, withBase, type Locale } from '../config/site';
import { getDict } from '../i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  frPath: string;
  enPath: string;
  image?: string;
  noindex?: boolean;
  pageType?: 'website' | 'article';
  rssPath?: string;
}

const {
  locale,
  title,
  description,
  frPath,
  enPath,
  image = 'media/og-image.png',
  noindex = false,
  pageType = 'website',
  rssPath,
} = Astro.props;

const dict = getDict(locale);
const canonical = absoluteUrl(locale === 'en' ? enPath : frPath);
const frUrl = absoluteUrl(frPath);
const enUrl = absoluteUrl(enPath);
const ogImage = absoluteMedia(image);
const whatsappMessage = dict.common.whatsappMessage;
// L'assistant n'est affiché que si la variable publique est activée au build (après déploiement de la fonction).
const assistantEnabled = import.meta.env.PUBLIC_ASSISTANT_ENABLED === 'true';

const credentials = [
  {
    name: 'Ethical Hacker',
    dateCreated: '2026-10-23',
    url: 'https://www.credly.com/badges/bc73a9b9-0b18-423f-b230-485a61ddfcc6/public_url',
  },
  {
    name: 'Junior Cybersecurity Analyst Career Path',
    dateCreated: '2026-03-20',
    url: 'https://www.credly.com/badges/28ac05ee-4d11-4114-9c58-15cbf86c4589/public_url',
  },
  {
    name: 'Networking Devices and Initial Configuration',
    dateCreated: '2026-03-17',
    url: 'https://www.credly.com/users/oscar-mulume',
  },
  {
    name: 'Networking Basics',
    dateCreated: '2026-03-04',
    url: 'https://www.credly.com/users/oscar-mulume',
  },
  {
    name: 'Introduction to Cybersecurity',
    dateCreated: '2022-07-10',
    url: 'https://www.credly.com/users/oscar-mulume',
  },
].map((credential) => ({
  '@type': 'EducationalOccupationalCredential',
  ...credential,
  credentialCategory: 'Badge',
  recognizedBy: {
    '@type': 'EducationalOrganization',
    name: 'Cisco Networking Academy',
    url: 'https://www.netacad.com/',
  },
}));

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  alternateName: SITE.shortName,
  url: absoluteUrl('/'),
  logo: absoluteMedia('logo.svg'),
  email: SITE.email,
  telephone: SITE.phone,
  founder: {
    '@type': 'Person',
    name: SITE.founder,
    sameAs: ['https://www.credly.com/users/oscar-mulume'],
    hasCredential: credentials,
  },
  hasCredential: credentials,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kinshasa',
    addressCountry: 'CD',
  },
  sameAs: [SITE.linkedin, SITE.github],
};
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('msec-theme');
          const preference = stored === 'light' || stored === 'dark' ? stored : 'auto';
          const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = preference === 'auto' ? (dark ? 'dark' : 'light') : preference;
          document.documentElement.dataset.themePreference = preference;
        } catch {
          document.documentElement.dataset.theme = 'light';
          document.documentElement.dataset.themePreference = 'auto';
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.founder} />
    <meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#081014" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />
    {rssPath && <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={absoluteUrl(rssPath)} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_CD' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'fr' ? 'en_US' : 'fr_CD'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.nav.skip}</a>
    <Header locale={locale} frPath={frPath} enPath={enPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppButton locale={locale} message={whatsappMessage} />
    {assistantEnabled && <msec-assistant app="msec" lang={locale}></msec-assistant>}
    {assistantEnabled && <script is:inline defer src={withBase('/assistant/v2/msec-assistant.js')}></script>}
  </body>
</html>

<style>
  main {
    padding-top: calc(var(--ms-header-height) + 1.5rem);
  }
</style>
