---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { getDict } from '../../i18n/utils';

const dict = getDict('en');
---

<BaseLayout
  locale="en"
  title={dict.meta.cookiesTitle}
  description={dict.meta.cookiesDescription}
  frPath="/cookies/"
  enPath="/en/cookies/"
>
  <LegalPage locale="en" page="cookies" />
</BaseLayout>
