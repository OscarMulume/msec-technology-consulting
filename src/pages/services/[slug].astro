    standards: ['ONVIF', 'IP67', 'AES-256', 'H.265', 'PoE+']
  },
  maintenance: {
    icon: '⚙️',
    title: 'Supervision IA & Maintenance Applicative',
    summary: 'Monitoring intelligent 24/7 avec agents autonomes. Nous intervenons avant la panne, pas après.',
    features: [
      { title: 'Agents Autonomes', desc: 'Surveillance proactive serveurs, réseau, caméras, bases de données.' },
      { title: 'Alertes Prédictives', desc: 'IA d\'anomalie — identification des signes avant-coureurs de panne.' },
      { title: 'Bases de Données', desc: 'Administration PostgreSQL, Supabase, optimisation des requêtes.' },
      { title: 'SLA 99.9%', desc: 'Temps de réponse 2h haute priorité, rapports mensuels.' },
      { title: 'Support Dédié', desc: 'Technicien dédié, helpdesk en ligne, intervention sur site.' },
    ],
    benefit: '✅ Anticipation des pannes — nous intervenons avant que l\'anomalie n\'impacte votre production.',
    standards: ['Supabase', 'PostgreSQL', 'Grafana', 'Prometheus', 'Zabbix']
  }
};

const svc = servicesData[SERVICE_SLUG];
if (svc) {
  document.getElementById('svc-icon').textContent = svc.icon;
  document.getElementById('svc-title').innerHTML = svc.title.replace(/(Connectivité|Cybersécurité|Infrastructure|Vidéosurveillance|Supervision)/, '<span class="accent">$1</span>');
  document.getElementById('svc-summary').textContent = svc.summary;
  const featuresEl = document.getElementById('svc-features');
  featuresEl.innerHTML = svc.features.map((f, i) => `
    <div class="feature-item">
      <span class="feature-num">0${i + 1}</span>
      <div><div class="feature-title">${f.title}</div><p class="feature-text">${f.desc}</p></div>
    </div>
  `).join('');
  document.getElementById('svc-benefit').innerHTML = `<div class="benefit-box"><p>${svc.benefit}</p></div>`;
  document.getElementById('svc-standards').innerHTML = `
    <div class="standards-block">
      <div class="standards-title">Standards & Technologies</div>
      <div class="standards-wrap">${svc.standards.map(s => `<span class="standard">${s}</span>`).join('')}</div>
    </div>
  `;
} else {
  document.getElementById('service-content').style.display = 'none';
  document.getElementById('not-found').style.display = 'block';
}
</script>
</body>
</html>
