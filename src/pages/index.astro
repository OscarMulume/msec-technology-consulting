<!-- ════════ SCRIPTS ════════ -->
<script>
(() => {
  const canvas = document.getElementById('bgCanvas');
  const ctx = canvas.getContext('2d');
  const CELL = 48, RADIUS = 160;
  const DOT_COLORS = ['34,211,238', '16,185,129', '20,184,166'];
  let w, h, cols, rows, targetMX = -9999, targetMY = -9999, mx = -9999, my = -9999, particles = [], frameCount = 0;
  function resize() { w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight; cols = Math.ceil(w / CELL) + 2; rows = Math.ceil(h / CELL) + 2; }
  function spawnParticle(x, y) { if (particles.length > 160) return; particles.push({ x, y, vx: (Math.random() - 0.5) * 0.6, vy: (Math.random() - 0.5) * 0.6, life: 1, decay: 0.006 + Math.random() * 0.012, size: 1 + Math.random() * 1.8, color: DOT_COLORS[Math.floor(Math.random() * DOT_COLORS.length)] }); }
  function draw() {
    ctx.clearRect(0, 0, w, h); frameCount++;
    mx += (targetMX - mx) * 0.12; my += (targetMY - my) * 0.12;
    const speed = Math.sqrt((mx - targetMX) ** 2 + (my - targetMY) ** 2);
    if (speed > 2) { const c = Math.min(Math.floor(speed / 3), 3); for (let i = 0; i < c; i++) spawnParticle(mx + (Math.random() - 0.5) * 16, my + (Math.random() - 0.5) * 16); }
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
      const cx = c * CELL + CELL / 2, cy = r * CELL + CELL / 2;
      const dist = Math.sqrt((cx - mx) ** 2 + (cy - my) ** 2);
      if (dist < RADIUS) {
        const intensity = Math.pow(1 - dist / RADIUS, 2.5);
        const pi = intensity * (0.85 + 0.15 * Math.sin(frameCount * 0.03 + dist * 0.02));
        ctx.fillStyle = `rgba(34,211,238,${pi * 0.08})`; ctx.fillRect(cx - CELL / 2, cy - CELL / 2, CELL - 1, CELL - 1);
        ctx.beginPath(); ctx.arc(cx, cy, 1.2 + pi * 2, 0, Math.PI * 2); ctx.fillStyle = `rgba(34,211,238,${0.12 + pi * 0.55})`; ctx.fill();
        if (c < cols - 1) { const rd = Math.sqrt(((c + 1) * CELL + CELL / 2 - mx) ** 2 + (cy - my) ** 2); if (rd < RADIUS) { const li = (intensity + Math.pow(1 - rd / RADIUS, 2.5)) / 2; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + CELL, cy); ctx.strokeStyle = `rgba(34,211,238,${li * 0.09})`; ctx.lineWidth = 0.8; ctx.stroke(); } }
        if (r < rows - 1) { const bd = Math.sqrt((cx - mx) ** 2 + ((r + 1) * CELL + CELL / 2 - my) ** 2); if (bd < RADIUS) { const li = (intensity + Math.pow(1 - bd / RADIUS, 2.5)) / 2; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx, cy + CELL); ctx.strokeStyle = `rgba(34,211,238,${li * 0.09})`; ctx.lineWidth = 0.8; ctx.stroke(); } }
      } else { ctx.beginPath(); ctx.arc(cx, cy, 0.6, 0, Math.PI * 2); ctx.fillStyle = 'rgba(148,163,184,0.03)'; ctx.fill(); }
    }
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i]; p.x += p.vx; p.y += p.vy; p.life -= p.decay;
      if (p.life <= 0) { particles.splice(i, 1); continue; }
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${p.color},${p.life * 0.45})`; ctx.fill();
      ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p.x - p.vx * 5, p.y - p.vy * 5);
      ctx.strokeStyle = `rgba(${p.color},${p.life * 0.1})`; ctx.lineWidth = p.size * 0.4; ctx.stroke();
    }
    const grad = ctx.createRadialGradient(mx, my, 0, mx, my, RADIUS);
    grad.addColorStop(0, 'rgba(34,211,238,0.06)'); grad.addColorStop(0.5, 'rgba(16,185,129,0.03)'); grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad; ctx.fillRect(mx - RADIUS, my - RADIUS, RADIUS * 2, RADIUS * 2);
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize', resize);
  window.addEventListener('mousemove', e => { targetMX = e.clientX; targetMY = e.clientY; });
  window.addEventListener('mouseleave', () => { targetMX = -9999; targetMY = -9999; });
  resize(); draw();
})();

// Navigation
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 50));
const mb = document.getElementById('mobBtn'), mm = document.getElementById('mobMenu');
mb?.addEventListener('click', () => mm.classList.toggle('open'));
mm?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mm.classList.remove('open')));
document.getElementById('yr').textContent = new Date().getFullYear();

// Scroll reveal
(function () {
  const els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window)) { els.forEach(el => el.classList.add('visible')); return; }
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.12 });
  els.forEach(el => obs.observe(el));
})();

// Bento cursor glow
document.querySelectorAll('.bento-card').forEach(card => {
  card.addEventListener('mousemove', (e) => {
    const r = card.getBoundingClientRect();
    card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
    card.style.setProperty('--my', (e.clientY - r.top) + 'px');
  });
});

// Contact form
document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const data = Object.fromEntries(new FormData(form));
  try {
    console.log('Contact form data:', data);
    document.getElementById('contact-success').style.display = 'block';
    document.getElementById('contact-error').style.display = 'none';
    form.reset();
  } catch (err) { document.getElementById('contact-error').style.display = 'block'; }
});

// Audit form
document.getElementById('audit-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const data = Object.fromEntries(new FormData(form));
  try {
    console.log('Audit form data:', data);
    document.getElementById('audit-success').style.display = 'block';
    document.getElementById('audit-error').style.display = 'none';
    form.reset();
  } catch (err) { document.getElementById('audit-error').style.display = 'block'; }
});
</script>

<!-- ════════ LIGHTBOX ════════ -->
<div class="lightbox" id="lightbox" onclick="closeLightbox()">
  <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
  <img id="lightbox-img" src="" alt="Image agrandie" />
</div>
<script>
function openLightbox(src) {
  document.getElementById('lightbox-img').src = src;
  document.getElementById('lightbox').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('open');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>
</body>
</html>
