<script>
(() => {
  const canvas = document.getElementById('bgCanvas');
  const ctx = canvas.getContext('2d');
  const CELL = 48;
  const RADIUS = 160;
  const DOT_COLORS = [
    '6,182,212',    // cyan (accent)
    '16,185,129',   // green
    '34,211,238',   // bright cyan
  ];

  let w, h, cols, rows;
  let targetMX = -9999, targetMY = -9999;
  let mx = -9999, my = -9999;
  let particles = [];
  let frameCount = 0;

  function resize() {
    w = canvas.width = window.innerWidth;
    h = canvas.height = window.innerHeight;
    cols = Math.ceil(w / CELL) + 2;
    rows = Math.ceil(h / CELL) + 2;
  }

  function spawnParticle(x, y) {
    if (particles.length > 180) return;
    particles.push({
      x, y,
      vx: (Math.random() - 0.5) * 0.6,
      vy: (Math.random() - 0.5) * 0.6,
      life: 1,
      decay: 0.006 + Math.random() * 0.012,
      size: 1 + Math.random() * 1.8,
      color: DOT_COLORS[Math.floor(Math.random() * DOT_COLORS.length)]
    });
  }

  function hexToRgb(hex) {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return `${r},${g},${b}`;
  }

  function draw() {
    ctx.clearRect(0, 0, w, h);
    frameCount++;

    mx += (targetMX - mx) * 0.12;
    my += (targetMY - my) * 0.12;

    const dx = mx - targetMX;
    const dy = my - targetMY;
    const speed = Math.sqrt(dx * dx + dy * dy);

    if (speed > 2) {
      const count = Math.min(Math.floor(speed / 3), 3);
      for (let i = 0; i < count; i++) {
        spawnParticle(
          mx + (Math.random() - 0.5) * 16,
          my + (Math.random() - 0.5) * 16
        );
      }
    }

    // Grid with glow
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const cx = c * CELL + CELL / 2;
        const cy = r * CELL + CELL / 2;
        const dist = Math.sqrt((cx - mx) ** 2 + (cy - my) ** 2);

        if (dist < RADIUS) {
          const intensity = Math.pow(1 - dist / RADIUS, 2.5);
          const pulseIntensity = intensity * (0.85 + 0.15 * Math.sin(frameCount * 0.03 + dist * 0.02));

          // Cell fill
          ctx.fillStyle = `rgba(6,182,212,${pulseIntensity * 0.09})`;
          ctx.fillRect(cx - CELL / 2, cy - CELL / 2, CELL - 1, CELL - 1);

          // Node dot
          ctx.beginPath();
          ctx.arc(cx, cy, 1.2 + pulseIntensity * 2, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(34,211,238,${0.15 + pulseIntensity * 0.65})`;
          ctx.fill();

          // Horizontal line
          if (c < cols - 1) {
            const rightDist = Math.sqrt(((c + 1) * CELL + CELL / 2 - mx) ** 2 + (cy - my) ** 2);
            if (rightDist < RADIUS) {
              const li = (intensity + Math.pow(1 - rightDist / RADIUS, 2.5)) / 2;
              ctx.beginPath();
              ctx.moveTo(cx, cy);
              ctx.lineTo(cx + CELL, cy);
              ctx.strokeStyle = `rgba(6,182,212,${li * 0.1})`;
              ctx.lineWidth = 0.8;
              ctx.stroke();
            }
          }
          // Vertical line
          if (r < rows - 1) {
            const bottomDist = Math.sqrt((cx - mx) ** 2 + ((r + 1) * CELL + CELL / 2 - my) ** 2);
            if (bottomDist < RADIUS) {
              const li = (intensity + Math.pow(1 - bottomDist / RADIUS, 2.5)) / 2;
              ctx.beginPath();
              ctx.moveTo(cx, cy);
              ctx.lineTo(cx, cy + CELL);
              ctx.strokeStyle = `rgba(6,182,212,${li * 0.1})`;
              ctx.lineWidth = 0.8;
              ctx.stroke();
            }
          }
        } else {
          // Static faint dots
          ctx.beginPath();
          ctx.arc(cx, cy, 0.6, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(148,163,184,0.04)';
          ctx.fill();
        }
      }
    }

    // Particles
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.life -= p.decay;

      if (p.life <= 0) {
        particles.splice(i, 1);
        continue;
      }

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${p.color},${p.life * 0.45})`;
      ctx.fill();

      // Trail
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(p.x - p.vx * 5, p.y - p.vy * 5);
      ctx.strokeStyle = `rgba(${p.color},${p.life * 0.12})`;
      ctx.lineWidth = p.size * 0.4;
      ctx.stroke();
    }

    // Cursor glow
    const grad = ctx.createRadialGradient(mx, my, 0, mx, my, RADIUS);
    grad.addColorStop(0, 'rgba(6,182,212,0.07)');
    grad.addColorStop(0.4, 'rgba(16,185,129,0.03)');
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(mx - RADIUS, my - RADIUS, RADIUS * 2, RADIUS * 2);

    requestAnimationFrame(draw);
  }

  window.addEventListener('resize', resize);
  window.addEventListener('mousemove', e => {
    targetMX = e.clientX;
    targetMY = e.clientY;
  });
  window.addEventListener('mouseleave', () => {
    targetMX = -9999;
    targetMY = -9999;
  });
  window.addEventListener('touchmove', e => {
    if (e.touches.length > 0) {
      targetMX = e.touches[0].clientX;
      targetMY = e.touches[0].clientY;
      e.preventDefault();
    }
  }, { passive: false });
  window.addEventListener('touchend', () => {
    targetMX = -9999;
    targetMY = -9999;
  });

  resize();
  draw();
})();
</script>

