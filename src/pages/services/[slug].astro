---
// Page de détail d'un service
export function getStaticPaths() {
  return [
    { params: { slug: 'connectivity' } },
    { params: { slug: 'infrastructure' } },
    { params: { slug: 'security' } },
    { params: { slug: 'cctv' } },
    { params: { slug: 'maintenance' } },
  ];
}
const { slug } = Astro.params;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Service | M-Sec Technology Consulting</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root{--bg:#0f172a;--bg2:#1e293b;--card:rgba(30,41,59,0.6);--border:rgba(148,163,184,0.1);--border-h:rgba(148,163,184,0.25);--text:#f8fafc;--text2:#94a3b8;--accent:#06b6d4;--accent-g:rgba(6,182,212,0.1);--accent-br:#22d3ee;--accent-dim:#0891b2;--green:#10b981;--green-g:rgba(16,185,129,0.1)}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);line-height:1.7;overflow-x:hidden}
    a{color:inherit;text-decoration:none}
    ul{list-style:none}
    .mono{font-family:'JetBrains Mono',monospace}
    #bgCanvas{position:fixed;inset:0;z-index:0;pointer-events:none}
    /* Nav */
    .nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:1rem 0;border-bottom:1px solid transparent;transition:all .3s}
    .nav.scrolled{background:rgba(15,23,42,0.9);backdrop-filter:blur(20px);border-bottom:1px solid var(--border)}
    .nav-inner{max-width:1200px;margin:0 auto;padding:0 2rem;display:flex;justify-content:space-between;align-items:center}
    .logo{font-size:1.125rem;font-weight:700;color:var(--text)}
    .logo em{font-style:normal;color:var(--accent-br)}
    .logo span{color:var(--text2);font-weight:400;font-size:.875rem}
    .nav-links{display:flex;gap:2rem;align-items:center}
    .nav-links a{color:var(--text2);font-size:.8125rem;font-weight:500;transition:color .2s}
    .nav-links a:hover{color:var(--text)}
    .back-link{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border:1px solid var(--border);border-radius:8px;font-size:.8125rem;color:var(--text2);transition:all .2s}
    .back-link:hover{border-color:var(--accent);color:var(--accent-br)}
    /* Layout */
    section{position:relative;z-index:1}
    .sw{max-width:1200px;margin:0 auto;padding:8rem 2rem 4rem}
    /* Service Hero */
    .service-hero{text-align:center;max-width:800px;margin:0 auto 4rem}
    .service-icon{width:72px;height:72px;border-radius:18px;margin:0 auto 1.5rem;background:var(--accent-g);display:flex;align-items:center;justify-content:center;font-size:2rem;border:1px solid rgba(6,182,212,.15)}
    .service-hero h1{font-size:clamp(2rem,5vw,3.5rem);font-weight:800;letter-spacing:-.03em;margin-bottom:1rem}
    .service-hero p{font-size:1.125rem;color:var(--text2);line-height:1.8;max-width:600px;margin:0 auto}
    /* Content */
    .cg{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.5rem;margin-bottom:3rem}
    .card{position:relative;padding:2rem;border-radius:16px;background:var(--card);border:1px solid var(--border);transition:all .3s}
    .card:hover{border-color:rgba(6,182,212,.2);transform:translateY(-4px)}
    .card h3{font-size:1.1rem;font-weight:700;margin-bottom:.75rem;color:var(--accent-br)}
    .card p{font-size:.9rem;color:var(--text2);line-height:1.7}
    .features-list{display:grid;grid-template-columns:1fr;gap:.75rem;margin-bottom:3rem}
    .feature-item{display:flex;align-items:flex-start;gap:.75rem;padding:1rem 1.25rem;border-radius:12px;background:var(--card);border:1px solid var(--border)}
    .feature-num{font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--accent-br);padding-top:.15rem;flex-shrink:0}
    .feature-text{font-size:.9rem;color:var(--text2);line-height:1.6}
    .benefit-box{padding:1.5rem;border-radius:14px;background:var(--green-g);border:1px solid rgba(16,185,129,.15);margin-bottom:3rem}
    .benefit-box p{font-size:.9375rem;color:var(--green);line-height:1.7;font-weight:500}
    .standards-wrap{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:3rem}
    .standard{padding:.35rem .875rem;border-radius:8px;font-size:.75rem;font-weight:600;letter-spacing:.03em;background:var(--accent-g);color:var(--accent-br);border:1px solid rgba(6,182,212,.15)}
    /* CTA */
    .cta-box{text-align:center;padding:3rem;border-radius:20px;background:linear-gradient(135deg,rgba(6,182,212,.05),rgba(16,185,129,.05));border:1px solid var(--border)}
    .cta-box h2{font-size:1.5rem;font-weight:700;margin-bottom:1rem}
    .cta-box p{font-size:.9375rem;color:var(--text2);margin-bottom:1.5rem}
    .btn{display:inline-flex;align-items:center;gap:.5rem;padding:.875rem 1.75rem;border-radius:10px;font-size:.9375rem;font-weight:600;cursor:pointer;transition:all .25s;border:none}
    .btn-primary{background:linear-gradient(135deg,var(--accent-dim),var(--accent));color:#fff;border:1px solid rgba(6,182,212,.3);box-shadow:0 0 20px rgba(6,182,212,.15)}
    .btn-primary:hover{transform:translateY(-2px);box-shadow:0 0 30px rgba(6,182,212,.25)}
    .btn-secondary{background:transparent;color:var(--text);border:1px solid var(--border)}
    .btn-secondary:hover{border-color:var(--accent)}
    .btn-group{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
    /* Not found */
    .not-found{text-align:center;padding:4rem 2rem}
    .not-found h2{font-size:2rem;font-weight:700;margin-bottom:1rem}
    .not-found p{color:var(--text2);margin-bottom:2rem}
    /* Footer */
    .footer{border-top:1px solid var(--border);padding:3rem 2rem;text-align:center;font-size:.8125rem;color:var(--text2)}
    @media(max-width:768px){.nav-links{display:none}}
  </style>
</head>
<body>
<canvas id="bgCanvas"></canvas>

<nav class="nav" id="nav"><div class="nav-inner">
  <a href="/" class="logo">M-<em>SEC</em> <span>Technology</span></a>
  <div class="nav-links">
    <a href="/">Accueil</a>
    <a href="/#services">Services</a>
    <a href="/#audit">Audit Gratuit</a>
    <a href="/#contact">Contact</a>
  </div>
</div></nav>

<section><div class="sw">
  <!-- Service Content - will be populated by JS from Supabase -->
  <div id="service-content">
    <div class="service-hero">
      <div class="service-icon" id="svc-icon">⚙️</div>
      <h1 id="svc-title">Chargement...</h1>
      <p id="svc-summary"></p>
    </div>
    <div id="svc-features"></div>
    <div id="svc-benefit"></div>
    <div id="svc-standards"></div>
    <div class="cta-box">
      <h2>Intéressé par ce service ?</h2>
      <p>Contactez-nous pour une consultation gratuite et sans engagement.</p>
      <div class="btn-group">
        <a href="/#audit" class="btn btn-primary">Demander un Audit Gratuit</a>
        <a href="/#contact" class="btn btn-secondary">Nous contacter</a>
      </div>
    </div>
  </div>

  <!-- Not found fallback -->
  <div id="not-found" class="not-found" style="display:none">
    <h2>Service non trouvé</h2>
    <p>Le service demandé n'existe pas ou a été déplacé.</p>
    <a href="/" class="btn btn-primary">Retour à l'accueil</a>
  </div>
</div></section>

<footer class="footer">&copy; <span id="yr"></span> M-Sec Technology Consulting. Tous droits réservés.</footer>

<script>
// Canvas background
(() => {
  const canvas = document.getElementById('bgCanvas'), ctx = canvas.getContext('2d');
  const CELL = 48, RADIUS = 160, DOT_COLORS = ['6,182,212','16,185,129','34,211,238'];
  let w, h, cols, rows, targetMX = -9999, targetMY = -9999, mx = -9999, my = -9999, particles = [], frameCount = 0;
  function resize() { w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight; cols = Math.ceil(w / CELL) + 2; rows = Math.ceil(h / CELL) + 2; }
  function spawnParticle(x, y) { if (particles.length > 120) return; particles.push({ x, y, vx: (Math.random() - 0.5) * 0.5, vy: (Math.random() - 0.5) * 0.5, life: 1, decay: 0.008 + Math.random() * 0.01, size: 1 + Math.random() * 1.5, color: DOT_COLORS[Math.floor(Math.random() * DOT_COLORS.length)] }); }
  function draw() {
    ctx.clearRect(0, 0, w, h); frameCount++;
    mx += (targetMX - mx) * 0.1; my += (targetMY - my) * 0.1;
    const speed = Math.sqrt((mx - targetMX) ** 2 + (my - targetMY) ** 2);
    if (speed > 2) { const c = Math.min(Math.floor(speed / 4), 2); for (let i = 0; i < c; i++) spawnParticle(mx + (Math.random() - 0.5) * 12, my + (Math.random() - 0.5) * 12); }
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const cx = c * CELL + CELL / 2, cy = r * CELL + CELL / 2;
        const dist = Math.sqrt((cx - mx) ** 2 + (cy - my) ** 2);
        if (dist < RADIUS) {
          const intensity = Math.pow(1 - dist / RADIUS, 2.5);
          ctx.fillStyle = `rgba(6,182,212,${intensity * 0.08})`; ctx.fillRect(cx - CELL / 2, cy - CELL / 2, CELL - 1, CELL - 1);
          ctx.beginPath(); ctx.arc(cx, cy, 1 + intensity * 1.5, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(34,211,238,${0.1 + intensity * 0.5})`; ctx.fill();
        } else { ctx.beginPath(); ctx.arc(cx, cy, 0.5, 0, Math.PI * 2); ctx.fillStyle = 'rgba(148,163,184,0.03)'; ctx.fill(); }
      }
    }
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i]; p.x += p.vx; p.y += p.vy; p.life -= p.decay;
      if (p.life <= 0) { particles.splice(i, 1); continue; }
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${p.color},${p.life * 0.4})`; ctx.fill();
    }
    const grad = ctx.createRadialGradient(mx, my, 0, mx, my, RADIUS);
    grad.addColorStop(0, 'rgba(6,182,212,0.06)'); grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad; ctx.fillRect(mx - RADIUS, my - RADIUS, RADIUS * 2, RADIUS * 2);
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize', resize); window.addEventListener('mousemove', e => { targetMX = e.clientX; targetMY = e.clientY; });
  window.addEventListener('mouseleave', () => { targetMX = -9999; targetMY = -9999; });
  resize(); draw();
})();

// Nav
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 50));
document.getElementById('yr').textContent = new Date().getFullYear();

// Service data (will be replaced by Supabase fetch)
const SERVICE_SLUG = window.location.pathname.split('/services/')[1]?.replace('/', '');

const servicesData = {
  connectivity: {
    icon: '🌐',
    title: 'Connectivité Critique & Réseaux Résilients',
    summary: 'Conception d\'architectures réseau sur mesure avec liaisons Internet redondantes. Du fibre optique au Starlink, nous garantissons une connectivité 99.9%.',
    features: [
      { title: 'Fibre Optique d\'entreprise', desc: 'Installation FTTH professionnelle avec SLA garanti et bande passante symétrique.' },
      { title: 'Starlink Business', desc: 'Solution satellite haut débit avec failover automatique pour zones rurales.' },
      { title: 'Antennes PtP/PtMP', desc: 'Liens sans fil longue portée pour interconnecter vos sites distants.' },
      { title: 'Routage Dynamique', desc: 'BGP, OSPF, VLANs — architectures réseau complexes et optimisées.' },
      { title: 'Wi-Fi Entreprise UniFi', desc: 'Couverture Wi-Fi professionnelle avec gestion centralisée et portail captif.' },
    ],
    benefit: '✅ Restez connecté même en cas de coupure de votre ligne principale. Notre système de failover automatique bascule en moins de 30 secondes.',
    standards: ['Cisco', 'UniFi', 'Starlink Business', 'MikroTik', 'TP-Link Omada']
  },
  infrastructure: {
    icon: '🏗️',
    title: 'Infrastructure Physique & Câblage Structuré',
    summary: 'Câblage structuré certifié aux normes TIA/EIA. Cat6/Cat6a, fibre monomode, baies de brassage — une infrastructure propre et documentée.',
    features: [
      { title: 'Câblage Cat6/Cat6a', desc: 'Certifié TIA/EIA-568 avec tests de diaphonie et d\'atténuation.' },
      { title: 'Fibre Monomode', desc: 'Liaisons inter-bâtiments en fibre OS2 avec connecteurs LC/SC.' },
      { title: 'Baies de Brassage', desc: 'Installation et organisation de baies 19" avec patch panels étiquetés.' },
      { title: 'Salles Serveurs', desc: 'Rack, climatisation, onduleurs, câblage structuré.' },
      { title: 'Documentation', desc: 'Schémas réseau, plans de câblage, rapports de certification.' },
    ],
    benefit: '✅ Infrastructure propre, documentée et certifiée — éliminez les micro-coupures matérielles et facilitez la maintenance future.',
    standards: ['TIA/EIA-568', 'Cat6a', 'OM4', 'OS2', 'ISO 11801']
  },
  security: {
    icon: '🔒',
    title: 'Cybersécurité Offensive & Durcissement',
    summary: 'Protection périmétrique et des terminaux. Tests de vulnérabilités, hardening, firewall NGFW — nous sécurisons vos systèmes de bout en bout.',
    features: [
      { title: 'Tests de Vulnérabilités', desc: 'Scans automatisés et pentesting manuel pour identifier les failles avant les attaquants.' },
      { title: 'Pare-feux FortiGate NGFW', desc: 'Pare-feux de nouvelle génération avec IPS, filtrage applicatif et VPN.' },
      { title: 'Isolation par VLANs', desc: 'Segmentation réseau stricte pour isoler les systèmes sensibles.' },
      { title: 'Durcissement (Hardening)', desc: 'Renforcement systématique de tous les équipements — zéro mot de passe par défaut.' },
      { title: 'DRP/BCP', desc: 'Plan de reprise et de continuité d\'activité testé et documenté.' },
    ],
    benefit: '✅ Immunisez vos systèmes face aux ransomwares et fuites de données. Sécurité par conception, zéro compromis.',
    standards: ['FortiGate', 'NIST', 'ISO 27001', 'OWASP', 'CIS Benchmarks']
  },
  cctv: {
    icon: '📹',
    title: 'Vidéosurveillance IP Haute Sécurité',
    summary: 'Caméras IP intelligentes avec flux chiffrés, détection IA, et accès distant 100% sécurisé via VPN.',
    features: [
      { title: 'Caméras IP HD/4K', desc: 'Vision nocturne IR, détection de mouvement IA, temps réel.' },
      { title: 'NVR Redondant', desc: 'Enregistrement sur disques RAID avec rétention configurable.' },
      { title: 'VLAN Caméras', desc: 'Isolation complète du réseau vidéo pour empêcher tout piratage.' },
      { title: 'Accès VPN', desc: 'Visualisation à distance 100% chiffrée, zéro exposition Internet.' },
      { title: 'Installation Pro', desc: 'Certification, SLA 95%+ uptime, maintenance préventive.' },
    ],
    benefit: '✅ Surveillez vos locaux avec l\'assurance que vos flux vidéo restent strictement privés et inviolables.',
    standards: ['ONVIF', 'IP67', 'AES-256', 'H.265', 'PoE+']
  },
  maintenance: {
    icon: '⚙️',
    title: 'Supervision IA & Maintenance Applicative',
    summary: 'Monitoring intelligent 24/7 avec agents autonomes. Nous intervenons avant la panne, pas après.',
    features: [
      { title: 'Agents Autonomes', desc: 'Surveillance proactive serveurs, réseau, caméras, bases de données.' },
      { title: 'Alertes Prédictives', desc: 'IA d\'anomalie — identification des signes avant-coureurs de panne.' },
      { title: 'Bases de Données', desc: 'Administration PostgreSQL, Supabase, optimisation des requêtes.' },
      { title: 'SLA 99.9%', desc: 'Temps de réponse 2h haute priorité, rapports mensuels.' },
      { title: 'Support Dédié', helpdesk: true, desc: 'Technicien dédié, helpdesk en ligne, intervention sur site.' },
    ],
    benefit: '✅ Anticipation des pannes — nous intervenons avant que l\'anomalie n\'impacte votre production.',
    standards: ['Supabase', 'PostgreSQL', 'Grafana', 'Prometheus', 'Zabbix']
  }
};

// Render service
const svc = servicesData[SERVICE_SLUG];
if (svc) {
  document.getElementById('svc-icon').textContent = svc.icon;
  document.getElementById('svc-title').textContent = svc.title;
  document.getElementById('svc-summary').textContent = svc.summary;

  const featuresEl = document.getElementById('svc-features');
  featuresEl.innerHTML = svc.features.map((f, i) => `
    <div class="feature-item">
      <span class="feature-num">0${i + 1}</span>
      <div><strong style="color:var(--text)">${f.title}</strong><p class="feature-text" style="margin-top:.25rem">${f.desc}</p></div>
    </div>
  `).join('');

  document.getElementById('svc-benefit').innerHTML = `<div class="benefit-box"><p>${svc.benefit}</p></div>`;

  document.getElementById('svc-standards').innerHTML = `
    <h3 style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--text2);margin-bottom:.75rem">Standards & Technologies</h3>
    <div class="standards-wrap">${svc.standards.map(s => `<span class="standard">${s}</span>`).join('')}</div>
  `;
} else {
  document.getElementById('service-content').style.display = 'none';
  document.getElementById('not-found').style.display = 'block';
}
</script>
</body>
</html>
