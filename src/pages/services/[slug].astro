---
// Page de détail d'un service — M-Sec Technology Consulting
// Design System Premium iOS (aligné sur l'accueil)
export function getStaticPaths() {
  return [
    { params: { slug: 'connectivity' } },
    { params: { slug: 'infrastructure' } },
    { params: { slug: 'security' } },
    { params: { slug: 'cctv' } },
    { params: { slug: 'maintenance' } },
  ];
}
const { slug } = Astro.params;
---
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#05060a" />
  <title>Service | M-Sec Technology Consulting</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:#05060a;--bg-2:#0a0c12;--cyan:#22d3ee;--cyan-dim:#0891b2;--cyan-g:rgba(34,211,238,0.10);
      --green:#10b981;--green-g:rgba(16,185,129,0.10);--teal:#14b8a6;
      --glass:rgba(255,255,255,0.03);--border:rgba(148,163,184,0.10);--border-h:rgba(34,211,238,0.25);
      --text:#f1f5f9;--text-2:#94a3b8;--text-3:#64748b;
      --spring:cubic-bezier(0.34,1.56,0.64,1);--smooth:cubic-bezier(0.22,1,0.36,1);--expo:cubic-bezier(0.16,1,0.3,1);
      --radius:22px;--radius-sm:14px;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:var(--bg);color:var(--text);line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    a{color:inherit;text-decoration:none}
    ul{list-style:none}
    .mono{font-family:'JetBrains Mono',monospace}
    img{max-width:100%}
    #bgCanvas{position:fixed;inset:0;z-index:0;pointer-events:none}
    .orb{position:fixed;border-radius:50%;filter:blur(150px);pointer-events:none;z-index:0}
    .orb-1{width:520px;height:520px;top:-220px;right:-180px;background:radial-gradient(circle,rgba(34,211,238,0.09),transparent 70%)}
    .orb-2{width:460px;height:460px;bottom:0;left:-200px;background:radial-gradient(circle,rgba(16,185,129,0.07),transparent 70%)}
    body::after{content:'';position:fixed;inset:0;z-index:1;pointer-events:none;opacity:0.03;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");background-repeat:repeat;background-size:256px}
    /* Nav */
    .nav{position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:1000;width:calc(100% - 32px);max-width:960px}
    .nav-pill{display:flex;align-items:center;justify-content:space-between;padding:10px 12px 10px 22px;border-radius:100px;background:rgba(10,12,18,0.55);backdrop-filter:blur(40px) saturate(1.8);-webkit-backdrop-filter:blur(40px) saturate(1.8);border:1px solid var(--border);transition:all .6s var(--expo)}
    .nav.scrolled .nav-pill{background:rgba(10,12,18,0.85);border-color:rgba(34,211,238,0.18);box-shadow:0 10px 40px rgba(0,0,0,0.4)}
    .logo{display:flex;align-items:center;gap:8px;font-size:1.05rem;font-weight:800;letter-spacing:-0.02em}
    .logo-mark{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,rgba(34,211,238,0.9),rgba(16,185,129,0.9));color:#04141a;font-weight:900;font-size:0.95rem;box-shadow:0 0 18px rgba(34,211,238,0.35)}
    .logo em{font-style:normal;color:var(--cyan)}
    .logo span{color:var(--text-2);font-weight:500;font-size:0.8rem}
    .nav-links{display:flex;gap:2px;align-items:center}
    .nav-links a{color:var(--text-2);font-size:0.8125rem;font-weight:500;padding:8px 14px;border-radius:100px;transition:all .35s var(--smooth)}
    .nav-links a:hover{color:var(--text);background:rgba(255,255,255,0.05)}
    .nav-cta{display:inline-flex;align-items:center;padding:8px 20px;border-radius:100px;font-size:0.8125rem;font-weight:600;background:linear-gradient(135deg,var(--cyan-dim),var(--cyan));color:#03130f;box-shadow:0 2px 14px rgba(34,211,238,0.3);transition:all .4s var(--spring)}
    .nav-cta:hover{transform:scale(1.04);box-shadow:0 4px 22px rgba(34,211,238,0.45)}
    .mob-btn{display:none;width:40px;height:40px;border-radius:12px;border:none;background:rgba(255,255,255,0.06);color:var(--text);cursor:pointer;align-items:center;justify-content:center}
    .mob-menu{display:none;position:fixed;top:74px;left:16px;right:16px;padding:12px;border-radius:20px;background:rgba(10,12,18,0.92);backdrop-filter:blur(40px);border:1px solid var(--border);flex-direction:column;gap:4px;z-index:999;transform:translateY(-10px);opacity:0;pointer-events:none;transition:all .4s var(--expo)}
    .mob-menu.open{transform:translateY(0);opacity:1;pointer-events:all}
    .mob-menu a{padding:14px 16px;border-radius:12px;font-size:0.9375rem;font-weight:500;color:var(--text-2)}
    .mob-menu a:hover{color:var(--text);background:rgba(255,255,255,0.05)}
    /* Layout */
    section{position:relative;z-index:2}
    .sw{max-width:1100px;margin:0 auto;padding:130px 24px 90px}
    /* Hero service */
    .service-hero{text-align:center;max-width:760px;margin:0 auto 56px}
    .service-icon{width:78px;height:78px;border-radius:22px;margin:0 auto 22px;background:var(--cyan-g);border:1px solid rgba(34,211,238,0.2);display:flex;align-items:center;justify-content:center;font-size:2rem;box-shadow:0 10px 40px rgba(34,211,238,0.15)}
    .service-hero h1{font-size:clamp(1.9rem,4.5vw,3.2rem);font-weight:800;letter-spacing:-0.035em;margin-bottom:16px;line-height:1.1}
    .service-hero h1 .accent{background:linear-gradient(135deg,var(--cyan),var(--green));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .service-hero p{font-size:1.05rem;color:var(--text-2);line-height:1.8;max-width:620px;margin:0 auto}
    .back-link{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:100px;border:1px solid var(--border);font-size:0.8125rem;color:var(--text-2);transition:all .3s;margin-bottom:40px}
    .back-link:hover{border-color:var(--border-h);color:var(--cyan);transform:translateX(-3px)}
    /* Features */
    .section-label{display:inline-flex;align-items:center;font-size:0.6875rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--cyan);margin-bottom:16px;padding:7px 16px;border-radius:100px;background:var(--cyan-g);border:1px solid rgba(34,211,238,0.18)}
    .features-block{background:var(--glass);backdrop-filter:blur(24px);border:1px solid var(--border);border-radius:var(--radius);padding:40px}
    .features-list{display:grid;grid-template-columns:1fr;gap:12px}
    .feature-item{display:flex;align-items:flex-start;gap:18px;padding:18px 20px;border-radius:var(--radius-sm);background:rgba(255,255,255,0.02);border:1px solid var(--border);transition:all .4s var(--smooth)}
    .feature-item:hover{border-color:var(--border-h);transform:translateX(4px);background:rgba(34,211,238,0.03)}
    .feature-num{font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--cyan);padding-top:3px;flex-shrink:0;font-weight:600}
    .feature-title{font-size:0.9375rem;font-weight:700;color:var(--text)}
    .feature-text{font-size:0.875rem;color:var(--text-2);line-height:1.65;margin-top:4px}
    /* Benefit */
    .benefit-box{background:var(--green-g);border:1px solid rgba(16,185,129,0.2);border-radius:var(--radius);padding:26px 28px;margin-top:24px}
    .benefit-box p{font-size:0.95rem;color:var(--green);line-height:1.7;font-weight:500}
    /* Standards */
    .standards-block{margin-top:24px}
    .standards-title{font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-2);margin-bottom:14px}
    .standards-wrap{display:flex;flex-wrap:wrap;gap:10px}
    .standard{padding:8px 16px;border-radius:100px;font-size:0.78rem;font-weight:600;letter-spacing:0.02em;background:var(--cyan-g);color:var(--cyan);border:1px solid rgba(34,211,238,0.18);transition:all .3s}
    .standard:hover{background:rgba(34,211,238,0.2)}
    /* CTA */
    .cta-box{margin-top:48px;text-align:center;padding:46px 32px;border-radius:26px;background:linear-gradient(135deg,rgba(34,211,238,0.10),rgba(16,185,129,0.08));border:1px solid rgba(34,211,238,0.2);backdrop-filter:blur(30px)}
    .cta-box h2{font-size:1.7rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:10px}
    .cta-box p{font-size:0.9375rem;color:var(--text-2);margin-bottom:24px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 26px;border-radius:100px;font-size:0.875rem;font-weight:600;cursor:pointer;transition:all .45s var(--spring);border:none}
    .btn-primary{background:linear-gradient(135deg,var(--cyan-dim),var(--cyan));color:#03130f;box-shadow:0 4px 20px rgba(34,211,238,0.25)}
    .btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(34,211,238,0.4)}
    .btn-ghost{background:rgba(255,255,255,0.04);color:var(--text);border:1px solid var(--border)}
    .btn-ghost:hover{border-color:var(--border-h);transform:translateY(-2px)}
    .btn-group{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
    /* Not found */
    .not-found{text-align:center;padding:60px 24px}
    .not-found h2{font-size:2rem;font-weight:800;margin-bottom:12px}
    .not-found p{color:var(--text-2);margin-bottom:24px}
    /* Footer */
    .footer{position:relative;z-index:2;border-top:1px solid var(--border);padding:32px 24px;text-align:center;font-size:0.8rem;color:var(--text-3)}
    @media(max-width:768px){.nav-links{display:none}.mob-btn{display:flex}.features-block{padding:24px}}
  </style>
</head>
<body>
<canvas id="bgCanvas"></canvas>
<div class="orb orb-1"></div><div class="orb orb-2"></div>

<nav class="nav" id="nav">
  <div class="nav-pill">
    <a href={import.meta.env.BASE_URL || '/'} class="logo"><span class="logo-mark">M</span><span>M-<em>SEC</em> <span>Technology</span></span></a>
    <div class="nav-links">
      <a href={`${import.meta.env.BASE_URL || '/'}`}>Accueil</a>
      <a href={`${import.meta.env.BASE_URL || '/'}#services`}>Services</a>
      <a href={`${import.meta.env.BASE_URL || '/'}#audit`}>Audit Gratuit</a>
      <a href={`${import.meta.env.BASE_URL || '/'}#contact`} class="nav-cta">Contact</a>
    </div>
    <button class="mob-btn" id="mobBtn" aria-label="Menu"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
  </div>
  <div class="mob-menu" id="mobMenu">
    <a href={`${import.meta.env.BASE_URL || '/'}`}>Accueil</a>
