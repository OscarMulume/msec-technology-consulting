---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { getDict } from '../../i18n/utils';

const dict = getDict('en');
---

<BaseLayout
  locale="en"
  title={dict.meta.legalNoticeTitle}
  description={dict.meta.legalNoticeDescription}
  frPath="/mentions-legales/"
  enPath="/en/legal-notice/"
>
  <LegalPage locale="en" page="legalNotice" />
</BaseLayout>
